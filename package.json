{
  "name": "anton-life-os",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Lokales, persönliches Life OS für Studium, Arbeit, Projekte und Alltag.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "env:check": "bash scripts/check-local-environment.sh",
    "db:start": "bash scripts/start-database.sh",
    "db:check": "bash scripts/check-database.sh",
    "db:stop": "bash scripts/stop-database.sh",
    "db:validate": "npm run db:validate --workspace @lifeos/database",
    "db:generate": "npm run db:generate --workspace @lifeos/database && npm run db:sqlite:generate --workspace @lifeos/database",
    "db:migrate": "npm run db:migrate:deploy --workspace @lifeos/database",
    "db:seed": "npm run db:seed --workspace @lifeos/database",
    "db:test": "npm test --workspace @lifeos/database",
    "db:sqlite:validate": "npm run db:sqlite:validate --workspace @lifeos/database",
    "db:sqlite:generate": "npm run db:sqlite:generate --workspace @lifeos/database",
    "db:sqlite:migrate": "npm run db:sqlite:migrate --workspace @lifeos/database",
    "db:sqlite:seed": "npm run db:sqlite:seed --workspace @lifeos/database",
    "db:sqlite:test": "npm run db:sqlite:test --workspace @lifeos/database",
    "db:sqlite:import": "node --import tsx scripts/sqlite-data.ts import",
    "db:sqlite:backup": "node --import tsx scripts/sqlite-data.ts backup",
    "db:sqlite:restore": "node --import tsx scripts/sqlite-data.ts restore",
    "db:sqlite:verify:recovery": "node --env-file-if-exists=.env --import tsx --test packages/database/tests/sqlite-transfer.integration.ts",
    "test:sqlite:api": "bash scripts/test-sqlite-api.sh",
    "verify:sqlite:api-runtime": "env DATABASE_URL=postgresql://unused:unused@127.0.0.1:5432/unused npm run db:generate && npm run db:sqlite:generate && npm run build --workspace @lifeos/api && node --import tsx scripts/verify-sqlite-api-runtime.ts",
    "desktop:prepare": "env DATABASE_URL=postgresql://unused:unused@127.0.0.1:5432/unused npm run db:generate && npm run build --workspace @lifeos/web && npm run build:desktop --workspace @lifeos/api && node scripts/prepare-mac-desktop.mjs",
    "desktop:verify:sidecar": "npm run desktop:prepare && node scripts/verify-mac-desktop-sidecar.mjs",
    "desktop:test": "npm run desktop:prepare && cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "desktop:build:app": "npm run desktop:prepare && npm run bundle:app --workspace @lifeos/desktop && bash scripts/sign-mac-app.sh",
    "desktop:build:dmg": "npm run desktop:build:app && npm run bundle:dmg --workspace @lifeos/desktop",
    "desktop:verify:dmg": "bash scripts/verify-mac-dmg.sh",
    "desktop:verify:update-rollback": "bash scripts/verify-mac-update-rollback.sh",
    "release:verify": "node scripts/verify-release-metadata.mjs",
    "release:build:local": "npm run release:verify && npm run desktop:build:dmg",
    "release:verify:local": "npm run release:verify && npm run desktop:verify:dmg",
    "demo:stabilization": "bash scripts/verify-stabilization-demo.sh",
    "db:backup": "bash scripts/backup-database.sh",
    "db:restore": "bash scripts/restore-database.sh",
    "db:verify:recovery": "bash scripts/verify-database-recovery.sh",
    "documents:backup": "node --import tsx scripts/document-data.ts backup",
    "documents:restore": "node --import tsx scripts/document-data.ts restore",
    "api:dev": "npm run dev --workspace @lifeos/api",
    "api:start": "npm run start --workspace @lifeos/api",
    "auth:bootstrap": "npm run auth:bootstrap --workspace @lifeos/api",
    "caldav:bootstrap": "npm run caldav:bootstrap --workspace @lifeos/api",
    "caldav:revoke": "npm run caldav:revoke --workspace @lifeos/api",
    "web:dev": "npm run dev --workspace @lifeos/web",
    "web:preview": "npm run preview --workspace @lifeos/web",
    "build": "npm run db:generate && npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspaces --if-present",
    "repo:check": "docker compose config --quiet",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "test": "npm run test:repo && npm run test --workspaces --if-present",
    "test:repo": "node --test tests/*.test.mjs",
    "typecheck": "npm run db:generate && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "minimatch@5.1.9": {
      "brace-expansion": "2.1.4"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "deepmerge-ts": "8.0.2",
    "esbuild": "0.28.2",
    "fast-uri": "3.1.6",
    "hono": "4.13.7",
    "mysql2": "3.24.3",
    "nanoid@3.0.0 - 3.3.17": "3.3.18",
    "postcss": "8.5.28",
    "qs": "6.16.0",
    "valibot": "1.4.2"
  }
}
