generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  externalId       String            @unique @db.VarChar(100)
  displayName      String            @db.VarChar(200)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  settings         UserSettings?
  credential       UserCredential?
  calDavCredential CalDavCredential?
  sessions         UserSession[]
  calendars        Calendar[]
  projects         Project[]
  projectGoals     ProjectGoal[]
  projectMilestones ProjectMilestone[]
  projectEventLinks ProjectEventLink[]
  tasks            Task[]
  taskEventLinks   TaskEventLink[]
  studyPrograms    StudyProgram[]
  studyModules     StudyModule[]
  studyEntries     StudyEntry[]
  workContexts     WorkContext[]
  workProjects     WorkProject[]
  workTaskLinks    WorkTaskLink[]
  workTimeEntries  WorkTimeEntry[]
  availabilityWindows AvailabilityWindow[]
  auditEvents      AuditEvent[]
}

model UserSettings {
  userId              String   @id @db.Uuid
  timezone            String   @default("Europe/Berlin") @db.VarChar(100)
  currencyCode        String   @default("EUR") @db.Char(3)
  locale              String   @default("de-DE") @db.VarChar(35)
  weekStartsOn        Int      @default(1)
  defaultCalendarView String   @default("week") @db.VarChar(10)
  showWeekends        Boolean  @default(true)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserCredential {
  userId       String   @id @db.Uuid
  passwordHash String   @db.VarChar(255)
  revision     Int      @default(1)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  tokenHash          String    @unique @db.Char(64)
  credentialRevision Int
  expiresAt          DateTime  @db.Timestamptz(3)
  revokedAt          DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model CalDavCredential {
  userId       String    @id @db.Uuid
  username     String    @unique @db.VarChar(100)
  passwordHash String    @db.VarChar(255)
  revision     Int       @default(1)
  revokedAt    DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Calendar {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @db.Uuid
  externalId String          @unique @db.VarChar(100)
  name       String          @db.VarChar(200)
  timezone   String          @default("Europe/Berlin") @db.VarChar(100)
  isPrimary  Boolean         @default(false)
  syncToken  Int             @default(0)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt  DateTime?       @db.Timestamptz(3)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events     CalendarEvent[]

  @@unique([id, userId])
  @@index([userId, deletedAt])
}

model CalendarEvent {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @db.Uuid
  calendarId      String          @db.Uuid
  uid             String          @db.VarChar(255)
  title           String          @db.VarChar(500)
  description     String?
  location        String?         @db.VarChar(500)
  startsAt        DateTime?       @db.Timestamptz(3)
  endsAt          DateTime?       @db.Timestamptz(3)
  startDate       DateTime?       @db.Date
  endDate         DateTime?       @db.Date
  timezone        String          @default("Europe/Berlin") @db.VarChar(100)
  isAllDay        Boolean         @default(false)
  recurrenceRule  String?         @db.Text
  reminderMinutes Int[]           @default([])
  etag            String          @db.VarChar(100)
  sequence        Int             @default(0)
  syncVersion     Int             @default(0)
  deletedAt       DateTime?       @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  calendar        Calendar        @relation(fields: [calendarId, userId], references: [id, userId], onDelete: Cascade)
  taskLinks       TaskEventLink[]
  studyEntries    StudyEntry[]
  workProjects    WorkProject[]
  projectLinks    ProjectEventLink[]

  @@unique([id, userId])
  @@unique([calendarId, uid])
  @@index([userId, deletedAt])
  @@index([calendarId, startsAt])
  @@index([calendarId, startDate])
  @@index([calendarId, deletedAt])
  @@index([calendarId, syncVersion])
}

enum TaskStatus {
  open
  in_progress
  blocked
  done
  cancelled
}

enum TaskPriority {
  low
  medium
  high
  critical
}

enum TaskArea {
  study
  work
  projects
  finance
  fitness
  personal
}

enum ProjectStatus {
  planned
  active
  paused
  completed
  cancelled
}

enum ProjectItemStatus {
  open
  in_progress
  completed
  cancelled
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  title       String        @db.VarChar(500)
  description String?
  status      ProjectStatus @default(planned)
  risk        String?
  dueDate     DateTime?     @db.Date
  archivedAt  DateTime?     @db.Timestamptz(3)
  deletedAt   DateTime?     @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals       ProjectGoal[]
  milestones  ProjectMilestone[]
  tasks       Task[]
  eventLinks  ProjectEventLink[]

  @@unique([id, userId])
  @@index([userId, deletedAt, archivedAt])
  @@index([userId, status, dueDate])
}

model ProjectGoal {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  projectId   String            @db.Uuid
  title       String            @db.VarChar(500)
  description String?
  status      ProjectItemStatus @default(open)
  risk        String?
  dueDate     DateTime?         @db.Date
  archivedAt  DateTime?         @db.Timestamptz(3)
  deletedAt   DateTime?         @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project           @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([id, userId])
  @@index([userId, projectId, deletedAt, archivedAt])
  @@index([userId, status, dueDate])
}

model ProjectMilestone {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  projectId   String            @db.Uuid
  title       String            @db.VarChar(500)
  description String?
  status      ProjectItemStatus @default(open)
  risk        String?
  dueDate     DateTime?         @db.Date
  archivedAt  DateTime?         @db.Timestamptz(3)
  deletedAt   DateTime?         @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project           @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([id, userId])
  @@index([userId, projectId, deletedAt, archivedAt])
  @@index([userId, status, dueDate])
}

model ProjectEventLink {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  projectId       String        @db.Uuid
  calendarEventId String        @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project       @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)
  calendarEvent   CalendarEvent @relation(fields: [calendarEventId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([userId, projectId, calendarEventId])
  @@index([userId, projectId])
  @@index([userId, calendarEventId])
}

model Task {
  id                       String          @id @default(uuid()) @db.Uuid
  userId                   String          @db.Uuid
  title                    String          @db.VarChar(500)
  description              String?
  status                   TaskStatus      @default(open)
  priority                 TaskPriority    @default(medium)
  dueDate                  DateTime?       @db.Date
  scheduledStartAt         DateTime?       @db.Timestamptz(3)
  scheduledStartTimezone   String?         @db.VarChar(100)
  estimatedDurationMinutes Int?
  tags                     String[]        @default([])
  area                     TaskArea        @default(personal)
  projectId                String?         @db.Uuid
  parentTaskId             String?         @db.Uuid
  completedAt              DateTime?       @db.Timestamptz(3)
  archivedAt               DateTime?       @db.Timestamptz(3)
  deletedAt                DateTime?       @db.Timestamptz(3)
  createdAt                DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime        @updatedAt @db.Timestamptz(3)
  user                     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project                  Project?        @relation(fields: [projectId, userId], references: [id, userId], onDelete: Restrict)
  parentTask               Task?           @relation("TaskHierarchy", fields: [parentTaskId, userId], references: [id, userId], onDelete: Restrict)
  subtasks                 Task[]          @relation("TaskHierarchy")
  eventLinks               TaskEventLink[]
  studyEntries             StudyEntry[]
  workTaskLinks            WorkTaskLink[]
  workTimeEntries          WorkTimeEntry[]

  @@unique([id, userId])
  @@index([userId, deletedAt, archivedAt])
  @@index([userId, status, dueDate])
  @@index([userId, priority, dueDate])
  @@index([userId, area, dueDate])
  @@index([parentTaskId])
  @@index([projectId])
}

model TaskEventLink {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  taskId          String        @db.Uuid
  calendarEventId String        @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  task            Task          @relation(fields: [taskId, userId], references: [id, userId], onDelete: Cascade)
  calendarEvent   CalendarEvent @relation(fields: [calendarEventId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([userId, taskId, calendarEventId])
  @@index([userId, taskId])
  @@index([userId, calendarEventId])
}

enum StudyStatus {
  planned
  active
  completed
  paused
  cancelled
}

enum StudyEntryKind {
  lecture
  exam
  submission
  learning
}

model StudyProgram {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  title       String        @db.VarChar(500)
  institution String        @db.VarChar(500)
  periodLabel String        @db.VarChar(200)
  status      StudyStatus   @default(planned)
  notes       String?
  archivedAt  DateTime?     @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  modules     StudyModule[]

  @@unique([id, userId])
  @@index([userId, archivedAt])
}

model StudyModule {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String       @db.Uuid
  programId          String       @db.Uuid
  code               String?      @db.VarChar(100)
  title              String       @db.VarChar(500)
  status             StudyStatus  @default(planned)
  credits            Decimal?     @db.Decimal(6, 2)
  grade              String?      @db.VarChar(100)
  notes              String?
  documentReferences String[]     @default([])
  archivedAt         DateTime?    @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  program            StudyProgram @relation(fields: [programId, userId], references: [id, userId], onDelete: Restrict)
  entries            StudyEntry[]

  @@unique([id, userId])
  @@index([userId, archivedAt])
  @@index([programId])
}

model StudyEntry {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  moduleId        String         @db.Uuid
  kind            StudyEntryKind
  title           String         @db.VarChar(500)
  status          StudyStatus    @default(planned)
  dueDate         DateTime?      @db.Date
  startsAt        DateTime?      @db.Timestamptz(3)
  endsAt          DateTime?      @db.Timestamptz(3)
  timezone        String?        @db.VarChar(100)
  credits         Decimal?       @db.Decimal(6, 2)
  grade           String?        @db.VarChar(100)
  notes           String?
  taskId          String?        @db.Uuid
  calendarEventId String?        @db.Uuid
  archivedAt      DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  module          StudyModule    @relation(fields: [moduleId, userId], references: [id, userId], onDelete: Restrict)
  task            Task?          @relation(fields: [taskId, userId], references: [id, userId], onDelete: Restrict)
  calendarEvent   CalendarEvent? @relation(fields: [calendarEventId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([id, userId])
  @@index([userId, archivedAt])
  @@index([moduleId])
  @@index([taskId])
  @@index([calendarEventId])
  @@index([userId, dueDate])
  @@index([userId, startsAt])
}

enum WorkStatus {
  planned
  active
  completed
  paused
  cancelled
}

enum WorkTimeKind {
  planned
  actual
}

model WorkContext {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  title        String          @db.VarChar(500)
  role         String          @db.VarChar(500)
  organization String?         @db.VarChar(500)
  startsOn     DateTime?       @db.Date
  endsOn       DateTime?       @db.Date
  timezone     String          @default("Europe/Berlin") @db.VarChar(100)
  status       WorkStatus      @default(planned)
  notes        String?
  archivedAt   DateTime?       @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects     WorkProject[]
  taskLinks    WorkTaskLink[]
  timeEntries  WorkTimeEntry[]

  @@unique([id, userId])
  @@index([userId, archivedAt])
  @@index([userId, status, startsOn])
}

model WorkProject {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @db.Uuid
  contextId       String          @db.Uuid
  title           String          @db.VarChar(500)
  status          WorkStatus      @default(planned)
  goal            String?
  deadlineDate    DateTime?       @db.Date
  calendarEventId String?         @db.Uuid
  notes           String?
  archivedAt      DateTime?       @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  context         WorkContext     @relation(fields: [contextId, userId], references: [id, userId], onDelete: Restrict)
  calendarEvent   CalendarEvent?  @relation(fields: [calendarEventId, userId], references: [id, userId], onDelete: Restrict)
  taskLinks       WorkTaskLink[]
  timeEntries     WorkTimeEntry[]

  @@unique([id, userId])
  @@index([userId, archivedAt])
  @@index([contextId])
  @@index([userId, status, deadlineDate])
  @@index([calendarEventId])
}

model WorkTaskLink {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  contextId String       @db.Uuid
  projectId String?      @db.Uuid
  taskId    String       @db.Uuid
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  context   WorkContext  @relation(fields: [contextId, userId], references: [id, userId], onDelete: Cascade)
  project   WorkProject? @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)
  task      Task         @relation(fields: [taskId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId, contextId])
  @@index([projectId])
}

model WorkTimeEntry {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  contextId  String       @db.Uuid
  projectId  String?      @db.Uuid
  taskId     String?      @db.Uuid
  kind       WorkTimeKind
  title      String       @db.VarChar(500)
  startsAt   DateTime     @db.Timestamptz(3)
  endsAt     DateTime     @db.Timestamptz(3)
  timezone   String       @db.VarChar(100)
  notes      String?
  archivedAt DateTime?    @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  context    WorkContext  @relation(fields: [contextId, userId], references: [id, userId], onDelete: Restrict)
  project    WorkProject? @relation(fields: [projectId, userId], references: [id, userId], onDelete: Restrict)
  task       Task?        @relation(fields: [taskId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([id, userId])
  @@index([userId, archivedAt])
  @@index([userId, kind, startsAt])
  @@index([contextId])
  @@index([projectId])
  @@index([taskId])
}

model AvailabilityWindow {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  weekday     Int
  startMinute Int
  endMinute   Int
  timezone    String   @db.VarChar(100)
  label       String?  @db.VarChar(200)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekday, startMinute, endMinute])
  @@index([userId, weekday])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String?  @db.VarChar(100)
  metadata   Json?
  occurredAt DateTime @default(now()) @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([entityType, entityId])
}
