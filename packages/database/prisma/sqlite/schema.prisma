generator client {
  provider            = "prisma-client"
  output              = "../../src/generated/sqlite"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id               String            @id @default(uuid())
  externalId       String            @unique
  displayName      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  settings         UserSettings?
  credential       UserCredential?
  calDavCredential CalDavCredential?
  sessions         UserSession[]
  calendars        Calendar[]
  auditEvents      AuditEvent[]
}

model UserSettings {
  userId              String   @id
  timezone            String   @default("Europe/Berlin")
  currencyCode        String   @default("EUR")
  locale              String   @default("de-DE")
  weekStartsOn        Int      @default(1)
  defaultCalendarView String   @default("week")
  showWeekends        Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserCredential {
  userId       String   @id
  passwordHash String
  revision     Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id                 String    @id @default(uuid())
  userId             String
  tokenHash          String    @unique
  credentialRevision Int
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model CalDavCredential {
  userId       String    @id
  username     String    @unique
  passwordHash String
  revision     Int       @default(1)
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Calendar {
  id         String          @id @default(uuid())
  userId     String
  externalId String          @unique
  name       String
  timezone   String          @default("Europe/Berlin")
  isPrimary  Boolean         @default(false)
  syncToken  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events     CalendarEvent[]

  @@unique([id, userId])
  @@index([userId, deletedAt])
}

model CalendarEvent {
  id              String    @id @default(uuid())
  userId          String
  calendarId      String
  uid             String
  title           String
  description     String?
  location        String?
  startsAt        DateTime?
  endsAt          DateTime?
  startDate       String?
  endDate         String?
  timezone        String    @default("Europe/Berlin")
  isAllDay        Boolean   @default(false)
  recurrenceRule  String?
  reminderMinutes Json      @default("[]")
  etag            String
  sequence        Int       @default(0)
  syncVersion     Int       @default(0)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  calendar        Calendar  @relation(fields: [calendarId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([id, userId])
  @@unique([calendarId, uid])
  @@index([userId, deletedAt])
  @@index([calendarId, startsAt])
  @@index([calendarId, startDate])
  @@index([calendarId, deletedAt])
  @@index([calendarId, syncVersion])
}

model AuditEvent {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  occurredAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([entityType, entityId])
}
