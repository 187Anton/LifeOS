generator client {
  provider            = "prisma-client"
  output              = "../../src/generated/sqlite"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                  String               @id @default(uuid())
  externalId          String               @unique
  displayName         String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  settings            UserSettings?
  credential          UserCredential?
  calDavCredential    CalDavCredential?
  sessions            UserSession[]
  calendars           Calendar[]
  projects            Project[]
  projectGoals        ProjectGoal[]
  projectMilestones   ProjectMilestone[]
  projectEventLinks   ProjectEventLink[]
  notes               Note[]
  noteVersions        NoteVersion[]
  documents           Document[]
  tasks               Task[]
  taskEventLinks      TaskEventLink[]
  studyPrograms       StudyProgram[]
  studyModules        StudyModule[]
  studyEntries        StudyEntry[]
  workContexts        WorkContext[]
  workProjects        WorkProject[]
  workTaskLinks       WorkTaskLink[]
  workTimeEntries     WorkTimeEntry[]
  availabilityWindows AvailabilityWindow[]
  aiInteractions      AiInteraction[]
  auditEvents         AuditEvent[]
}

model UserSettings {
  userId              String   @id
  timezone            String   @default("Europe/Berlin")
  currencyCode        String   @default("EUR")
  locale              String   @default("de-DE")
  weekStartsOn        Int      @default(1)
  defaultCalendarView String   @default("week")
  showWeekends        Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserCredential {
  userId       String   @id
  passwordHash String
  revision     Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id                 String    @id @default(uuid())
  userId             String
  tokenHash          String    @unique
  credentialRevision Int
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model CalDavCredential {
  userId       String    @id
  username     String    @unique
  passwordHash String
  revision     Int       @default(1)
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Calendar {
  id         String          @id @default(uuid())
  userId     String
  externalId String          @unique
  name       String
  timezone   String          @default("Europe/Berlin")
  isPrimary  Boolean         @default(false)
  syncToken  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events     CalendarEvent[]

  @@unique([id, userId])
  @@index([userId, deletedAt])
}

model CalendarEvent {
  id              String          @id @default(uuid())
  userId          String
  calendarId      String
  uid             String
  title           String
  description     String?
  location        String?
  startsAt        DateTime?
  endsAt          DateTime?
  startDate       String?
  endDate         String?
  timezone        String          @default("Europe/Berlin")
  isAllDay        Boolean         @default(false)
  recurrenceRule  String?
  reminderMinutes Json            @default("[]")
  etag            String
  sequence        Int             @default(0)
  syncVersion     Int             @default(0)
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  calendar        Calendar        @relation(fields: [calendarId, userId], references: [id, userId], onDelete: Cascade)
  taskLinks       TaskEventLink[]
  studyEntries    StudyEntry[]
  workProjects    WorkProject[]
  projectLinks    ProjectEventLink[]

  @@unique([id, userId])
  @@unique([calendarId, uid])
  @@index([userId, deletedAt])
  @@index([calendarId, startsAt])
  @@index([calendarId, startDate])
  @@index([calendarId, deletedAt])
  @@index([calendarId, syncVersion])
}

enum TaskStatus {
  open
  in_progress
  blocked
  done
  cancelled
}

enum TaskPriority {
  low
  medium
  high
  critical
}

enum TaskArea {
  study
  work
  projects
  finance
  fitness
  personal
}

enum ProjectStatus {
  planned
  active
  paused
  completed
  cancelled
}

enum ProjectItemStatus {
  open
  in_progress
  completed
  cancelled
}

model Project {
  id          String        @id @default(uuid())
  userId      String
  title       String
  description String?
  status      ProjectStatus @default(planned)
  risk        String?
  dueDate     String?
  searchEnabled Boolean     @default(false)
  archivedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals       ProjectGoal[]
  milestones  ProjectMilestone[]
  tasks       Task[]
  eventLinks  ProjectEventLink[]
  notes       Note[]
  documents   Document[]

  @@unique([id, userId])
  @@index([userId, deletedAt, archivedAt])
  @@index([userId, status, dueDate])
}

model ProjectGoal {
  id          String            @id @default(uuid())
  userId      String
  projectId   String
  title       String
  description String?
  status      ProjectItemStatus @default(open)
  risk        String?
  dueDate     String?
  archivedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project           @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([id, userId])
  @@index([userId, projectId, deletedAt, archivedAt])
  @@index([userId, status, dueDate])
}

model ProjectMilestone {
  id          String            @id @default(uuid())
  userId      String
  projectId   String
  title       String
  description String?
  status      ProjectItemStatus @default(open)
  risk        String?
  dueDate     String?
  archivedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project           @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([id, userId])
  @@index([userId, projectId, deletedAt, archivedAt])
  @@index([userId, status, dueDate])
}

model ProjectEventLink {
  id              String        @id @default(uuid())
  userId          String
  projectId       String
  calendarEventId String
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project       @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)
  calendarEvent   CalendarEvent @relation(fields: [calendarEventId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([userId, projectId, calendarEventId])
  @@index([userId, projectId])
  @@index([userId, calendarEventId])
}

model Task {
  id                       String          @id @default(uuid())
  userId                   String
  title                    String
  description              String?
  status                   TaskStatus      @default(open)
  priority                 TaskPriority    @default(medium)
  dueDate                  String?
  scheduledStartAt         DateTime?
  scheduledStartTimezone   String?
  estimatedDurationMinutes Int?
  tags                     Json            @default("[]")
  area                     TaskArea        @default(personal)
  projectId                String?
  parentTaskId             String?
  completedAt              DateTime?
  archivedAt               DateTime?
  deletedAt                DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  user                     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project                  Project?        @relation(fields: [projectId, userId], references: [id, userId], onDelete: NoAction)
  parentTask               Task?           @relation("TaskHierarchy", fields: [parentTaskId, userId], references: [id, userId], onDelete: NoAction)
  subtasks                 Task[]          @relation("TaskHierarchy")
  eventLinks               TaskEventLink[]
  studyEntries             StudyEntry[]
  workTaskLinks            WorkTaskLink[]
  workTimeEntries          WorkTimeEntry[]

  @@unique([id, userId])
  @@index([userId, deletedAt, archivedAt])
  @@index([userId, status, dueDate])
  @@index([userId, priority, dueDate])
  @@index([userId, area, dueDate])
  @@index([parentTaskId])
  @@index([projectId])
}

model TaskEventLink {
  id              String        @id @default(uuid())
  userId          String
  taskId          String
  calendarEventId String
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  task            Task          @relation(fields: [taskId, userId], references: [id, userId], onDelete: Cascade)
  calendarEvent   CalendarEvent @relation(fields: [calendarEventId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([userId, taskId, calendarEventId])
  @@index([userId, taskId])
  @@index([userId, calendarEventId])
}

enum StudyStatus {
  planned
  active
  completed
  paused
  cancelled
}

enum StudyEntryKind {
  lecture
  exam
  submission
  learning
}

model StudyProgram {
  id          String        @id @default(uuid())
  userId      String
  title       String
  institution String
  periodLabel String
  status      StudyStatus   @default(planned)
  notes       String?
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  modules     StudyModule[]

  @@unique([id, userId])
  @@index([userId, archivedAt])
}

model StudyModule {
  id                 String       @id @default(uuid())
  userId             String
  programId          String
  code               String?
  title              String
  status             StudyStatus  @default(planned)
  credits            Decimal?
  grade              String?
  notes              String?
  documentReferences Json         @default("[]")
  searchEnabled       Boolean      @default(false)
  archivedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  program            StudyProgram @relation(fields: [programId, userId], references: [id, userId], onDelete: NoAction)
  entries            StudyEntry[]
  knowledgeNotes     Note[]
  documents          Document[]

  @@unique([id, userId])
  @@index([userId, archivedAt])
  @@index([programId])
}

model Note {
  id            String        @id @default(uuid())
  userId        String
  projectId     String?
  studyModuleId String?
  title         String
  content       String
  format        String        @default("markdown")
  category      String?
  tags          Json          @default("[]")
  version       Int           @default(1)
  searchEnabled Boolean       @default(false)
  archivedAt    DateTime?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?      @relation(fields: [projectId, userId], references: [id, userId], onDelete: NoAction)
  studyModule   StudyModule?  @relation(fields: [studyModuleId, userId], references: [id, userId], onDelete: NoAction)
  versions      NoteVersion[]

  @@unique([id, userId])
  @@index([userId, deletedAt, archivedAt])
  @@index([projectId])
  @@index([studyModuleId])
}

model NoteVersion {
  id        String   @id @default(uuid())
  userId    String
  noteId    String
  version   Int
  title     String
  content   String
  category  String?
  tags      Json     @default("[]")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      Note     @relation(fields: [noteId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([noteId, version])
  @@index([userId, noteId])
}

model Document {
  id            String       @id @default(uuid())
  userId        String
  projectId     String?
  studyModuleId String?
  storageKey    String       @unique
  fileName      String
  mimeType      String
  byteSize      Int
  sha256        String
  modifiedAt    DateTime
  searchEnabled Boolean      @default(false)
  extractedText String?
  archivedAt    DateTime?
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?     @relation(fields: [projectId, userId], references: [id, userId], onDelete: NoAction)
  studyModule   StudyModule? @relation(fields: [studyModuleId, userId], references: [id, userId], onDelete: NoAction)

  @@unique([id, userId])
  @@index([userId, deletedAt, archivedAt])
  @@index([projectId])
  @@index([studyModuleId])
}

model StudyEntry {
  id              String         @id @default(uuid())
  userId          String
  moduleId        String
  kind            StudyEntryKind
  title           String
  status          StudyStatus    @default(planned)
  dueDate         String?
  startsAt        DateTime?
  endsAt          DateTime?
  timezone        String?
  credits         Decimal?
  grade           String?
  notes           String?
  taskId          String?
  calendarEventId String?
  archivedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  module          StudyModule    @relation(fields: [moduleId, userId], references: [id, userId], onDelete: NoAction)
  task            Task?          @relation(fields: [taskId, userId], references: [id, userId], onDelete: NoAction)
  calendarEvent   CalendarEvent? @relation(fields: [calendarEventId, userId], references: [id, userId], onDelete: NoAction)

  @@unique([id, userId])
  @@index([userId, archivedAt])
  @@index([moduleId])
  @@index([taskId])
  @@index([calendarEventId])
  @@index([userId, dueDate])
  @@index([userId, startsAt])
}

enum WorkStatus {
  planned
  active
  completed
  paused
  cancelled
}

enum WorkTimeKind {
  planned
  actual
}

model WorkContext {
  id           String          @id @default(uuid())
  userId       String
  title        String
  role         String
  organization String?
  startsOn     String?
  endsOn       String?
  timezone     String          @default("Europe/Berlin")
  status       WorkStatus      @default(planned)
  notes        String?
  archivedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects     WorkProject[]
  taskLinks    WorkTaskLink[]
  timeEntries  WorkTimeEntry[]

  @@unique([id, userId])
  @@index([userId, archivedAt])
  @@index([userId, status, startsOn])
}

model WorkProject {
  id              String          @id @default(uuid())
  userId          String
  contextId       String
  title           String
  status          WorkStatus      @default(planned)
  goal            String?
  deadlineDate    String?
  calendarEventId String?
  notes           String?
  searchEnabled   Boolean      @default(false)
  archivedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  context         WorkContext     @relation(fields: [contextId, userId], references: [id, userId], onDelete: NoAction)
  calendarEvent   CalendarEvent?  @relation(fields: [calendarEventId, userId], references: [id, userId], onDelete: NoAction)
  taskLinks       WorkTaskLink[]
  timeEntries     WorkTimeEntry[]

  @@unique([id, userId])
  @@index([userId, archivedAt])
  @@index([contextId])
  @@index([userId, status, deadlineDate])
  @@index([calendarEventId])
}

model WorkTaskLink {
  id        String       @id @default(uuid())
  userId    String
  contextId String
  projectId String?
  taskId    String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  context   WorkContext  @relation(fields: [contextId, userId], references: [id, userId], onDelete: Cascade)
  project   WorkProject? @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)
  task      Task         @relation(fields: [taskId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId, contextId])
  @@index([projectId])
}

model WorkTimeEntry {
  id         String       @id @default(uuid())
  userId     String
  contextId  String
  projectId  String?
  taskId     String?
  kind       WorkTimeKind
  title      String
  startsAt   DateTime
  endsAt     DateTime
  timezone   String
  notes      String?
  archivedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  context    WorkContext  @relation(fields: [contextId, userId], references: [id, userId], onDelete: NoAction)
  project    WorkProject? @relation(fields: [projectId, userId], references: [id, userId], onDelete: NoAction)
  task       Task?        @relation(fields: [taskId, userId], references: [id, userId], onDelete: NoAction)

  @@unique([id, userId])
  @@index([userId, archivedAt])
  @@index([userId, kind, startsAt])
  @@index([contextId])
  @@index([projectId])
  @@index([taskId])
}

model AvailabilityWindow {
  id          String   @id @default(uuid())
  userId      String
  weekday     Int
  startMinute Int
  endMinute   Int
  timezone    String
  label       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekday, startMinute, endMinute])
  @@index([userId, weekday])
}

model AuditEvent {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  occurredAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([entityType, entityId])
}

model AiInteraction {
  id                       String   @id @default(uuid())
  userId                   String
  requestHash              String
  status                   String
  providerId               String?
  processingMode           String   @default("local")
  externalTransferOccurred Boolean  @default(false)
  sourceReferences         Json
  responseMetadata         Json
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, userId])
  @@index([userId, createdAt])
}
